NODE_ENV=development
LOG_LEVEL=info
DB_PATH=./data/music-channel.sqlite
OUTPUT_DIR=./outputs
PUBLISH_TIMEZONE=Asia/Taipei
DAILY_PUBLISH_HOUR=21

MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MUSIC_MODEL=music-2.6
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_FORMAT=png
NOTION_API_KEY=
NOTION_DATABASE_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Multi-channel mode.
# Keep legacy YOUTUBE_* values for shared OAuth client settings, then add named channel profiles here.
# Profiles inherit YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET, and YOUTUBE_REDIRECT_URI when omitted.
# `playlists` maps publish-package series names to playlist IDs.
YOUTUBE_ACTIVE_CHANNEL=orbital_focus
YOUTUBE_CHANNELS_JSON={"orbital_focus":{"name":"Orbital Focus","channelId":"","refreshToken":"","defaultPlaylistId":"","playlists":{"Lunar Night Shift":"","Orbital Systems":"","Deep Space Focus":""}},"channel_2":{"name":"","channelId":"","refreshToken":"","defaultPlaylistId":"","playlists":{}},"channel_3":{"name":"","channelId":"","refreshToken":"","defaultPlaylistId":"","playlists":{}}}
